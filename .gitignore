# 本机配置、秘密及交付产物
/.local/
/out/
/env/*.env
/env/*.local
**/.env
**/.env.*
!**/*.env.example
!**/.env.example
**/*.jks
**/*.keystore
**/key.properties
**/local.properties

# Dart / Flutter
**/.dart_tool/
**/.pub/
**/.pub-cache/
/src/**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/coverage/

# 原生工具中间产物
**/.gradle/
**/Pods/
**/DerivedData/
**/Flutter/ephemeral/
**/flutter/ephemeral/
**/xcuserdata/

# 编辑器及系统文件
**/.idea/
**/*.iml
**/.DS_Store
**/Thumbs.db
**/*.log
**/__pycache__/
**/*.pyc

# 不忽略 pubspec.lock：应用需要提交锁文件。
